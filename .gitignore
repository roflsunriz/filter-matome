# ========================================
# NicoCache_nl Git管理設定
# 管理対象：local/, nlFilters/の一部のみ
# ========================================

# ========================================
# Eclipse/IDE関連ファイル
# ========================================
.classpath
.project
.settings/
.externalToolBuilders/
*.code-workspace
.vscode/

# ========================================
# バッチファイル・スクリプト
# ========================================
*.bat
*.sh
*.vbs
*.pyw
*.py
easy_*.ps1

# ========================================
# Java関連ファイル
# ========================================
*.jar
*.jar.old
*.jar.sig
build.xml
*.class

# ========================================
# 設定・データディレクトリ
# ========================================
config.*
data/
defaults/
certs/
.mp4_cache

# ========================================
# ドキュメント・README
# ========================================
*.txt
documents/
Readme_*.txt
autoUpdater.md
config_editor.md
convert_any_to_h264.md
easyScripts.md
mp4RenameFromExtThumb.md
nicocache_utiliity.md

# ========================================
# ライブラリ・外部ツール
# ========================================
lib/
# extensionsフォルダ内の全てを除外
extensions/*
# ただし、以下の4つのJavaファイル（とclassファイル）は除外しない（管理対象に含める）
!extensions/CommentFilterLogger.java
!extensions/CommentFilterLogger.class
!extensions/CustomCacheReturner.java
!extensions/CustomCacheReturner.class
!extensions/downloadThruFFmpeg.java
!extensions/downloadThruFFmpeg.class
!extensions/ExtUtil.java
!extensions/ExtUtil.class
others/
link/
filter-matome/
nlFilters-Syntax-HighLighter/

# ========================================
# キャッシュ・一時ファイル
# ========================================
cache/
thcache/
*.log
*.bak
*.tmp
*.temp

# ========================================
# ソースコード（管理対象外）
# ========================================
src/

# ========================================
# アイコン・実行ファイル
# ========================================
*.ico
*.exe
*.dll
*.property
*.pac
*.sig

# ========================================
# その他の除外ファイル
# ========================================
list/
tatus
autoUpdater.pyw

# ========================================
# Node.js関連（local/内も除外）
# ========================================
node_modules/
# package.json  # GitHub Actionsで必要なので除外対象から削除
# package-lock.json  # GitHub Actionsで必要なので除外対象から削除
tsconfig.json
playwright.config.ts
.eslintrc.json

# ========================================
# メディアファイル（管理対象外）
# ========================================
images/
background-images/
*.gif
*.svg
*.jpg
*.jpeg
*.png
*.webp

# ========================================
# JavaScript/HTML/CSS（管理対象外）
# ========================================
05_cache_remove_button.js
15_cached_link_color.js
20_watchpage.js
nllib_watch.js
nllib.js
url_injection_sys.js
popThumb.js
script.js
nlThumbInfoRewriter.js
overlib_mini.js
nllib_xsStorage.html
nl_cacheIcon.css

# ========================================
# データファイル
# ========================================
*.json
mime.types*
*.default

# ========================================
# local/内の除外設定
# ========================================
local/.gitignore
local/features/.gitignore
local/features/tests/
local/features/tests-examples/
local/features/node_modules/
# local/features/package.json  # GitHub Actionsで必要なので除外対象から削除
# local/features/package-lock.json  # GitHub Actionsで必要なので除外対象から削除
local/features/tsconfig.json
local/features/playwright.config.ts
local/features/.eslintrc.json
local/features/features.code-workspace

# ========================================
# nlFilters内の除外設定（100-199以外）
# ========================================
nlFilters/01_globalFilter.txt
nlFilters/05_topBarFilter.txt
nlFilters/06_topBarが2段になるのを解消.txt
nlFilters/08_MutationObserverHooks.txt
nlFilters/10_thumbInfoFilter(ポップアップリンク用).txt
nlFilters/15_thumbInfoFilter(基本).txt
nlFilters/15_01_thumbInfoFilter(追加).txt
nlFilters/15_02_thumbInfoFilter(Nアニメfreeのみ).txt
nlFilters/20_watchFilter.txt
nlFilters/99_3列Filter+mod.txt
nlFilters/dmcキャッシュのアイコンと色を変えないやつ/
nlFilters/evac/

# ========================================
# 管理対象ファイル（明示的に含める）
# ========================================
