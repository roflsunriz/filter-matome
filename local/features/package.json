{
  "name": "filter-matome-features",
  "private": true,
  "type": "module",
  "workspaces": [],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun scripts/build.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p scripts/sandbox/tsconfig.json",
    "lint": "eslint src/**/*.ts scripts/sandbox/*.ts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" \"*.ts\" package.json",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" \"*.ts\" package.json",
    "benchmark:comment-filter": "bun tests/comment-filter2-performance.bench.ts",
    "benchmark:comment-filter-prototypes": "bun ../../benchmarks/comment-filter-core/benchmark.ts",
    "sandbox:capture-official": "bun scripts/sandbox/capture-official-watch-bundle.ts",
    "sandbox:analyze-official": "bun scripts/sandbox/analyze-official-watch-bundle.ts",
    "sandbox:observe-membership": "bun scripts/sandbox/observe-membership-context.ts",
    "sandbox:observe-seek-preview": "bun scripts/sandbox/observe-seek-preview.ts",
    "sandbox:run-membership": "bun scripts/sandbox/run-offline-membership-sandbox.ts",
    "sandbox:run-seek-preview": "bun scripts/sandbox/run-offline-seek-preview-sandbox.ts",
    "sandbox:verify-offline": "bun scripts/sandbox/verify-offline-cdp-sandbox.ts",
    "sandbox:type-check": "tsc --noEmit -p scripts/sandbox/tsconfig.json",
    "test:unit": "bun scripts/test-unit.ts",
    "test:e2e": "playwright test tests/mlink-video-controller.spec.ts tests/mlink-video-controller-lifecycle.spec.ts tests/watch-history.spec.ts tests/watch-tracker.spec.ts tests/mylist2.spec.ts tests/comment-filter2.spec.ts tests/movie-info.spec.ts tests/cache-data-manager.spec.ts tests/video-player.spec.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "error-check": "bun run type-check && bun run lint",
    "verify": "bun run format:check && bun run lint && bun run type-check && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "eslint": "10.6.0",
    "prettier": "^3.9.4",
    "typescript": "6.0.2",
    "typescript-eslint": "8.63.0"
  },
  "version": "235",
  "description": "Enhancing scripts for Niconico",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "@material-design-icons/svg": "^0.14.15",
    "comment-overlay": "4.1.4",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "hls.js": "^1.6.16",
    "image-validator": "^1.2.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "brace-expansion": "^5.0.7",
    "fast-uri": "^4.1.0",
    "flatted": "^3.4.2",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.5"
  }
}
