{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@/*": [
        "./src/*",
        "./node_modules/comment-overlay/dist/types/*"
      ]
    },
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "isolatedModules": true,
    "types": ["vite/client"],
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/**/*.ts",
    "src/types/vite-env.d.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "config", "scripts", "tests", "tests-examples"]
} 
